# Beta deployment environment. Copy to deploy/.env and fill in real values.
# (deploy/.env is read both by docker compose interpolation and by the portal
# container via env_file.)

# The public DNS name of the VM (no scheme). With Azure, set a DNS label on
# the VM's public IP to get e.g. sourcerer-beta.centralindia.cloudapp.azure.com
SITE_ADDRESS=sourcerer-beta.centralindia.cloudapp.azure.com

# Postgres password (also used in the portal's DATABASE_URL).
POSTGRES_PASSWORD=change-me-long-random

# Google OAuth web client. Register BOTH of these on the client:
#   Authorized JavaScript origin:  https://<SITE_ADDRESS>
#   Authorized redirect URI:       https://<SITE_ADDRESS>/api/v1/portal/auth/callback
GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123

# HS256 session-signing secret. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SESSION_SECRET=change-me-48-random-chars

# Comma-separated admin emails (approve requests, admin dashboard).
ADMIN_EMAILS=you@example.com

# Drive folder the portal catalogs (metadata only).
# The folder ID from its Drive URL: drive.google.com/drive/folders/<THIS>
PORTAL_ROOT_FOLDER_ID=your-drive-folder-id

# Optional tuning
PORTAL_SYNC_INTERVAL_MINUTES=360
PORTAL_SYNC_EXCLUDE=__pycache__,node_modules,venv,.venv,*.pyc
PORTAL_CONVERT_TIMEOUT_SECONDS=180
