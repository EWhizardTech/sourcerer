# Environment variables for Sourcerer Backend

# Path to the Google service account JSON key file.
# Used by the Google Drive ingestion module to authenticate.
# Example: secrets/my-service-account.json
GDRIVE_SERVICE_ACCOUNT_PATH=secrets/acc.json

QDRANT_API_KEY=abc123
QDRANT_URL=https://qdrant-endpoint.com
QDRANT_CLUSTER_ID=abcd123
QDRANT_COLLECTION_NAME=soucerer_collection

DOCLING_ACCELERATOR_DEVICE=cpu

GROQ_API_KEY=gsk_12312313,gsk_12312313,gsk_12312313,gsk_12312313
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=AQ.123

REDIS_URL=redis://localhost:6380

CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_BACKEND_URL=redis://localhost:6380/1

TAVILY_API_KEY=       # Required for web search via Tavily. Leave empty to disable web search.
# Local artifact storage for quiz NLP/ML stack.
# Keep these paths project-relative so caches and model assets stay inside repo.
ML_CACHE_DIR=.cache
HF_HOME=.cache/huggingface
HUGGINGFACE_HUB_CACHE=.cache/huggingface/hub
TRANSFORMERS_CACHE=.cache/huggingface/transformers
TORCH_HOME=.cache/torch
NLTK_DATA_DIR=.cache/nltk_data
SPACY_MODEL_DIR=.cache/spacy
SPACY_MODEL_NAME=en_core_web_sm
HF_TOKEN=hf_123
