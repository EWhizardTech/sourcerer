# Environment variables for Sourcerer Backend

# Path to the Google service account JSON key file.
# Used by the Google Drive ingestion module to authenticate.
# Example: secrets/my-service-account.json
GDRIVE_SERVICE_ACCOUNT_PATH=secrets/acc.json

QDRANT_API_KEY=abc123
QDRANT_CLUSTER_ENDPOINT=https://qdrant-endpoint.com
QDRANT_CLUSTER_ID=abcd123
QDRANT_COLLECTION=soucerer_test_collection

DOCLING_ACCELERATOR_DEVICE=cpu
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant
