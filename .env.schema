# Environment variables for Sourcerer.
# Copy to .env and fill in real values. Docker Compose injects Redis and
# cache-path overrides automatically — you only need the credentials here.

# --- Gateway CORS ---
# Comma-separated browser origins allowed to call the gateway.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Google Drive ingestion ---
# Path to the service account JSON key (mounted read-only in Docker).
GDRIVE_SERVICE_ACCOUNT_PATH=secrets/acc.json

# --- Qdrant (vector store) ---
QDRANT_API_KEY=abc123
QDRANT_URL=https://qdrant-endpoint.com
QDRANT_COLLECTION_NAME=sourcerer_collection

# --- Parsing ---
DOCLING_ACCELERATOR_DEVICE=cpu

# --- Groq (retrieval agent + tagging) ---
GROQ_API_KEY=gsk_12312313
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- Gemini (embeddings) ---
GEMINI_API_KEY=AQ.123

# --- Tavily (optional web search; empty disables it) ---
TAVILY_API_KEY=

# --- Resource portal (services/portal) ---
# Google OAuth web client for portal sign-in. Redirect URI must be registered
# on the OAuth client exactly as GOOGLE_CALLBACK_URL (the gateway URL).
GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123
GOOGLE_CALLBACK_URL=http://localhost:8001/api/v1/portal/auth/callback
# HS256 secret for portal session JWTs — generate a long random string.
PORTAL_SESSION_SECRET=change-me-long-random
# Comma-separated admin emails (approve/deny requests, admin dashboard).
ADMIN_EMAILS=you@example.com
# Drive folder the portal catalogs (metadata only — no content ingestion).
# The folder ID from its Drive URL: drive.google.com/drive/folders/<THIS>
PORTAL_ROOT_FOLDER_ID=your-drive-folder-id
# Where the browser lands after sign-in; must be an allowed origin below.
PORTAL_FRONTEND_ORIGIN=http://localhost:3001
PORTAL_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Cookies: keep defaults for localhost; secure=true + samesite=none for
# cross-domain HTTPS deployments.
PORTAL_COOKIE_SECURE=false
PORTAL_COOKIE_SAMESITE=lax
# Catalog sync cadence and name globs to skip (junk dirs).
PORTAL_SYNC_INTERVAL_MINUTES=360
PORTAL_SYNC_EXCLUDE=__pycache__,node_modules,venv,.venv,*.pyc
# Office->PDF conversion timeout (LibreOffice headless).
PORTAL_CONVERT_TIMEOUT_SECONDS=120
# Postgres password used by the compose postgres + portal services.
POSTGRES_PASSWORD=sourcerer
# Async SQLAlchemy URL (local dev; compose overrides in-network).
DATABASE_URL=postgresql+asyncpg://sourcerer:sourcerer@localhost:5433/sourcerer_portal

# --- Redis / Celery (local dev; compose overrides these in-network) ---
REDIS_URL=redis://localhost:6380/2
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_BACKEND_URL=redis://localhost:6380/1

# --- Retrieval quality ---
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_OVERFETCH=3

# --- Chat memory ---
CHAT_HISTORY_TTL_SECONDS=86400
CHAT_HISTORY_MAX_MESSAGES=20

# --- Quiz NLP assets (project-relative caches; compose overrides in Docker) ---
ML_CACHE_DIR=.cache
HF_HOME=.cache/huggingface
HUGGINGFACE_HUB_CACHE=.cache/huggingface/hub
TRANSFORMERS_CACHE=.cache/huggingface/transformers
TORCH_HOME=.cache/torch
NLTK_DATA_DIR=.cache/nltk_data
SPACY_MODEL_DIR=.cache/spacy
SPACY_MODEL_NAME=en_core_web_sm
HF_TOKEN=
