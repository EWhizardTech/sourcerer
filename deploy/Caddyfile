# One origin for the whole app. Caddy provisions Let's Encrypt automatically
# for SITE_ADDRESS (must be a real DNS name pointing at this VM).

{$SITE_ADDRESS} {
	encode zstd gzip

	# Baseline security headers for every response served from this origin.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		# flush_interval -1: no response buffering (video streaming, SSE later)
		reverse_proxy gateway:8000 {
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy gateway:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
