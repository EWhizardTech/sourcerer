# Staging environment. Copy to deploy/.env ON THE STAGING HOST and fill in.
# Staging mirrors production (same docker-compose.beta.yml, secure cookies,
# auto-HTTPS) but on its own DNS name, its own DB, and its own secrets.

# Staging DNS name (no scheme).
SITE_ADDRESS=staging.sourcerer.example.com

# Staging Postgres password (DISTINCT from prod).
POSTGRES_PASSWORD=change-me-staging-random

# Google OAuth web client — register the STAGING origin + redirect URI:
#   JS origin:    https://staging.sourcerer.example.com
#   redirect URI: https://staging.sourcerer.example.com/api/v1/portal/auth/callback
# Use a separate OAuth client from prod if you want isolation.
GOOGLE_CLIENT_ID=1234-staging.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-staging

# DISTINCT session secret from prod:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SESSION_SECRET=change-me-staging-48-random-chars

# Admins for staging (often the internal team only).
ADMIN_EMAILS=you@example.com

# Drive folder to catalog (can point at a smaller test folder for staging).
PORTAL_ROOT_FOLDER_ID=your-drive-folder-id

# Optional tuning
PORTAL_SYNC_INTERVAL_MINUTES=360
PORTAL_SYNC_EXCLUDE=__pycache__,node_modules,venv,.venv,*.pyc
PORTAL_CONVERT_TIMEOUT_SECONDS=180
