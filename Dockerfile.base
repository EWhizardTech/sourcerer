# Dockerfile.base — dependency layer only. Rebuild when pyproject.toml/uv.lock change:
#   docker build -f Dockerfile.base -t premdharshan/sourcerer-base:latest .
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Copy ONLY dependency files — this layer is cached until the lockfile changes.
COPY pyproject.toml uv.lock ./

# --frozen: install exactly what's locked (no re-resolution).
# Linux resolves CPU torch wheels via [tool.uv.sources] — no CUDA downloads.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

ENV PATH="/app/.venv/bin:$PATH"
